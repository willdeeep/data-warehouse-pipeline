# Copy to terraform.tfvars (gitignored) and fill in your values:
#     cp terraform.tfvars.example terraform.tfvars
# This is the ONLY supported way to configure Terraform. Do NOT rely on TF_VAR_* from .env —
# a literal (non-shell) .env load passes the string "${GCP_PROJECT_ID}" and can destroy resources.
#
# NOTE: prod is normally deployed by CI (deploy-main.yml) using GitHub Environment variables,
# not a local tfvars — this file is for a manual/break-glass prod apply. prod datasets/buckets
# are deletion-protected (allow_dataset_deletion=false, force_destroy=false).

project_id        = "your-gcp-project-id"
state_bucket_name = "your-gcp-project-id-tfstate" # globally-unique GCS bucket for Terraform state

# Optional (defaults shown):
# region      = "us-central1"
# bq_location = "US"

# Python / uv
__pycache__/
*.pyc
.venv/
uv.lock.bak

# Env & secrets
.env
*.env.local
**/secrets/*.json
!**/secrets/.gitkeep

# dbt
pipeline/dbt/target/
pipeline/dbt/logs/
pipeline/dbt/dbt_packages/
pipeline/dbt/seeds/
.user.yml

# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
*.tfplan
tfplan
crash.log
# Module-level provider locks are generated by the terraform_validate pre-commit hook; only the
# env-root .terraform.lock.hcl files (environments/*/) are tracked.
infra/terraform/modules/*/.terraform.lock.hcl

# Airflow / Astro
logs/
*.log
.astro/
ASTRO_API_TOKEN.txt

# Planning workspace + local agent config (kept untracked)
.opencode/
.claude/

# OS / editor
.DS_Store
*.DS_Store
.idea/
.vscode/

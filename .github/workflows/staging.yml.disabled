# ============================================================================
# STAGING TEST + DEPLOY — INTENTIONALLY DISABLED (issue #28)
# ============================================================================
# This workflow is authored but DISABLED to conserve GitHub Actions minutes.
# The `.disabled` extension means GitHub does not register or run it.
#
# Intended behaviour (documented in docs/RELEASE.md):
#   - On PR into `staging`: run the full CI matrix as a required check.
#   - On push to `staging`: auto-deploy (terraform apply) the staging environment.
#
# Until enabled, STAGING DEPLOYS ARE MANUAL:
#   cd infra/terraform/environments/staging
#   terraform init -backend-config="bucket=<TF_STATE_BUCKET>"
#   terraform apply
#
# To enable later: rename to `staging.yml` and create the `staging` GitHub Environment
# + branch protection on `staging`.
# ============================================================================
name: Staging (test + deploy) [DISABLED]

on:
  pull_request:
    branches: [staging]
  push:
    branches: [staging]

permissions:
  contents: read
  id-token: write

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v5
      - run: uvx ruff check data_generation
      - run: cd data_generation && uv sync --extra dev && uv run pytest -q
      - uses: hashicorp/setup-terraform@v3
      - run: |
          for e in dev staging prod; do
            ( cd "infra/terraform/environments/$e" \
              && terraform init -backend=false -input=false && terraform validate )
          done

  deploy-staging:
    needs: test
    if: github.event_name == 'push'
    runs-on: ubuntu-latest
    environment: staging
    steps:
      - uses: actions/checkout@v4
      - id: auth
        uses: google-github-actions/auth@v2
        with:
          workload_identity_provider: ${{ vars.WIF_PROVIDER }}
          service_account: ${{ vars.DEPLOY_SA_EMAIL }}
      - uses: hashicorp/setup-terraform@v3
      - name: Terraform apply (staging)
        working-directory: infra/terraform/environments/staging
        env:
          TF_VAR_project_id: ${{ vars.GCP_PROJECT_ID }}
          TF_VAR_region: ${{ vars.GCP_REGION }}
          TF_VAR_bq_location: ${{ vars.BQ_LOCATION }}
          TF_VAR_state_bucket_name: ${{ vars.TF_STATE_BUCKET }}
        run: |
          terraform init -input=false -backend-config="bucket=${{ vars.TF_STATE_BUCKET }}"
          terraform plan -input=false -out=tfplan
          # Safety gate: never auto-approve a plan that DESTROYS or REPLACES a resource
          # (a misconfigured TF_VAR forces a name/project change → destroy+recreate).
          if terraform show -json tfplan | jq -e '[.resource_changes[].change.actions[]] | index("delete") | not' >/dev/null; then
            terraform apply -input=false tfplan
          else
            echo "::error::Staging plan contains destroy/replace actions — refusing to auto-apply. Inspect the plan and apply manually."
            exit 1
          fi

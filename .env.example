# =============================================================================
# Loom Insights Data Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

# =============================================================================
# Google Cloud Platform Configuration
# =============================================================================
# Choose ONE of the following authentication methods:

# Option 1: Service Account Key File (Local Development - RECOMMENDED for local)
GOOGLE_APPLICATION_CREDENTIALS=/opt/airflow/dbt/secrets/your-service-account-key.json

# Option 2: Service Account JSON String (Astronomer/Production - RECOMMENDED for deployment)
# DBT_BIGQUERY_KEYFILE_JSON={"type":"service_account","project_id":"your-project",...}

# GCP Project and Configuration
GCP_PROJECT_ID=loom-insights
GCP_REGION=US

# =============================================================================
# DBT Configuration
# =============================================================================
DBT_ROOT_PATH=/opt/airflow/dbt
DBT_PROFILES_DIR=/opt/airflow/dbt
DBT_TARGET=dev
DBT_THREADS=4
DBT_DEV_DATASET=dev_warehouse
DBT_PROD_DATASET=warehouse

# =============================================================================
# Airflow Configuration
# =============================================================================
# Docker Fernet Key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
AIRFLOW__CORE__FERNET_KEY=your-fernet-key-here

# Airflow Webserver Secret Key for session security (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
AIRFLOW__WEBSERVER__SECRET_KEY=your-webserver-secret-key-here

# =============================================================================
# Data Pipeline Configuration
# =============================================================================
# Raw CSV export path for extract_raw_data.py
RAW_CSV_PATH=dags/dbt/seeds/raw_competitor_data.csv
# Transformed CSV export path for transform_data.py
TRANSFORMED_CSV_PATH=dags/dbt/seeds/transformed_competitor_data.csv

# =============================================================================
# eBay API Credentials
# =============================================================================
CLIENT_ID=your-ebay-client-id
CLIENT_SECRET=your-ebay-client-secret

# =============================================================================
# Slack Notifications
# =============================================================================
# Get your webhook URL from: https://api.slack.com/apps
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# =============================================================================
# Google Cloud Storage
# =============================================================================
# GCS Bucket for DAG logs
DAG_LOGS_BUCKET=your-dag-logs-bucket

# =============================================================================
# Security Notes
# =============================================================================
# Generate secure keys with:
# - FERNET_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# - SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"

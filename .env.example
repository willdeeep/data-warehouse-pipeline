# =============================================================================
# Loom Insights Data Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

# =============================================================================
# Google Cloud Platform Configuration
# =============================================================================
# Authentication is OAuth2 / Application Default Credentials (ADC). No keyfiles.
# Run once, as the account that OWNS the project, before Terraform / dbt / the generator:
#   gcloud auth login
#   gcloud auth application-default login
#   gcloud config set project <your-project-id>
#   gcloud auth application-default set-quota-project <your-project-id>

# GCP Project and Configuration (use a project YOU own)
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
BQ_LOCATION=US
TF_STATE_BUCKET=your-gcp-project-id-tfstate   # globally-unique GCS bucket for Terraform state

# -----------------------------------------------------------------------------
# Terraform variables
# -----------------------------------------------------------------------------
# Terraform is configured PER ENVIRONMENT via `terraform.tfvars`, NOT from this file.
# In each infra/terraform/environments/<env>/ dir:
#     cp terraform.tfvars.example terraform.tfvars   # then fill in your values
# This is deterministic regardless of how `.env` is loaded.
#
# DO NOT re-introduce `TF_VAR_*=${GCP_PROJECT_ID}` self-references here: they only expand
# under a shell `source .env`, and an IDE/dotenv loader that reads `.env` LITERALLY will pass
# Terraform the string "${GCP_PROJECT_ID}" — which forces a name/project change and can DESTROY
# your datasets/buckets on the next apply. Keep Terraform config in tfvars.

# =============================================================================
# DBT Configuration
# =============================================================================
# Local dbt paths (relative to repo root). The Airflow container overrides these to
# /opt/airflow/dbt in pipeline/docker-compose.yaml (where ./dbt is mounted).
DBT_PROFILES_DIR=pipeline/dbt
DBT_PROJECT_DIR=pipeline/dbt
DBT_ROOT_PATH=pipeline/dbt
DBT_TARGET=dev
DBT_THREADS=4
# Env-prefixed datasets (#29). Dev values shown; for prod use loom_sync / warehouse.
DBT_SOURCE_DATASET=dev_loom_sync      # raw Faker source (dbt 'loom_sync' source)
DBT_WAREHOUSE_DATASET=dev_warehouse   # dbt target + eBay landing (ebay_transformed)

# =============================================================================
# Synthetic data generator (data_generation) — env-prefixed LOOM_* vars
# =============================================================================
LOOM_PROJECT_ID=${GCP_PROJECT_ID}
LOOM_SOURCE_DATASET=dev_loom_sync     # datagen loads here (dev). Use loom_sync for prod.

# =============================================================================
# Airflow Configuration
# =============================================================================
# Docker Fernet Key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
AIRFLOW__CORE__FERNET_KEY=your-fernet-key-here

# Airflow Webserver Secret Key for session security (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
AIRFLOW__WEBSERVER__SECRET_KEY=your-webserver-secret-key-here

# =============================================================================
# Data Pipeline Configuration
# =============================================================================
# Raw CSV export path for the eBay ETL (reworked in Plan 04)
RAW_CSV_PATH=pipeline/dbt/seeds/raw_competitor_data.csv
# Transformed CSV export path for the eBay ETL
TRANSFORMED_CSV_PATH=pipeline/dbt/seeds/transformed_competitor_data.csv

# =============================================================================
# eBay API Credentials
# =============================================================================
CLIENT_ID=your-ebay-client-id
CLIENT_TOKEN=your-ebay-client-secret

# =============================================================================
# Slack Notifications
# =============================================================================
# Get your webhook URL from: https://api.slack.com/apps
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# =============================================================================
# Security Notes
# =============================================================================
# Generate secure keys with:
# - FERNET_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# - SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
